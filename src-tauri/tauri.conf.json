{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lume",
  "version": "0.2.18",
  "identifier": "app.lume.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Lume",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0e0f11",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Cliente desktop do Claude com várias contas",
    "category": "Productivity",
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "Lume",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MjlCNDAxRDJDRTRDQzUKUldURlRNN1NBYlFwRmd6ejg2N3RYSXZ0VFo5T1hUQURJV1d4dHo5MHlvekRiQUNyQjRaeGtzL3AK",
      "endpoints": [
        "https://github.com/lucas3g/lume/releases/latest/download/latest.json"
      ]
    }
  }
}
